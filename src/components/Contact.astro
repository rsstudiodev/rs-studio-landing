---
import i18n from "i18next";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappHref } from "@/lib/whatsapp";

const email = i18n.t("contact.email");
---

<section id="contact" data-reveal class="relative isolate bg-pine-deep px-gutter parallax-plate [--plate-pad:var(--spacing-section-lg)] text-reverse">
  <div class="relative mx-auto w-full max-w-content">
    <h2 class="max-w-[18ch] text-headline display-face text-balance">
      {i18n.t("contact.title")}
    </h2>
    <p class="mt-lead max-w-prose text-lead text-pretty text-reverse-mute">
      {i18n.t("contact.intro")}
    </p>
    <div class="mt-cta-lg flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-13 items-center bg-lichen px-6 py-4 text-pine transition-colors duration-200 hover:bg-paper active:scale-[0.99]"
      >
        <span class="text-lead-sm font-medium">{email}</span>
      </a>
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-13 items-center gap-2.5 border border-reverse-rule px-6 py-4 transition-colors duration-200 hover:border-lichen hover:text-lichen"
      >
        <WhatsAppIcon class="h-4.5 w-4.5" />
        <span class="text-lead-sm font-medium">{i18n.t("whatsapp.cta")}</span>
      </a>
    </div>
    <footer class="mt-footer border-t border-reverse-rule pt-8">
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6">
        <img
          src="/logo.svg"
          alt={i18n.t("nav.logoAlt")}
          width="1261"
          height="209"
          class="h-5 w-auto invert"
        />
        <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
          <a
            href="https://www.facebook.com/rsstudiodev/"
            rel="noopener noreferrer"
            target="_blank"
            class="label text-reverse-mute transition-colors duration-200 hover:text-lichen"
          >
            {i18n.t("contact.facebook")}
          </a>
          <a
            href={`mailto:${email}`}
            class="label text-reverse-mute transition-colors duration-200 hover:text-lichen"
          >
            {i18n.t("contact.emailLabel")}
          </a>
          <span class="label text-reverse-mute">{i18n.t("contact.copyright")}</span>
        </div>
      </div>
    </footer>
  </div>
</section>
