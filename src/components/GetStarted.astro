---
import i18n from "i18next";
import SectionHead from "./SectionHead.astro";
import Quoter from "./Quoter.astro";
import { WHATSAPP_PHONE } from "@/lib/whatsapp";

const quoter = i18n.t("getStarted.quoter", { returnObjects: true });
const secondaryCta = {
  label: i18n.t("quoter.scheduleCall"),
  eventSlug: "rs-studio/descubrimiento",
};
---

<section id="get-started" data-reveal class="relative isolate bg-paper px-gutter py-section parallax-plate">
  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("getStarted.title")} meta={i18n.t("getStarted.meta")} />
    <div class="mt-heading max-w-5xl">
      <Quoter
        instanceId={quoter.instanceId}
        sectionTitle={quoter.sectionTitle}
        whatsappNumber={WHATSAPP_PHONE}
        whatsappTemplate={quoter.whatsappTemplate}
        questions={quoter.questions}
        secondaryCta={secondaryCta}
        collectContact
        surface="paper"
        introText={i18n.t("getStarted.introText")}
      />
    </div>
  </div>
</section>
