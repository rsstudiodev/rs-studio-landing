---
import i18n from "i18next";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappHref } from "@/lib/whatsapp";
import { projectScreenshots, projectScreenshotAlts } from "@/content/projects";
import { readImageSize } from "@/lib/imageSize";
import demoIdiomas from "@/assets/demo-idiomas.jpg";
import demoGimnasio from "@/assets/demo-gimnasio.jpg";

type Shot = {
  src: string;
  ratio: number;
  project: number;
  width: number;
  height: number;
  alt?: string;
};

const RATIO_TOLERANCE = 0.06;

const SCREEN_FRAMES = 4;

const measured: Shot[] = projectScreenshots.flatMap((shots, project) =>
  shots.flatMap((src, index) => {
    const size = readImageSize(src);
    const alt = projectScreenshotAlts[project]?.[index];
    return size
      ? [{ src, project, ratio: size.width / size.height, ...size, alt }]
      : [];
  }),
);

function median(values: number[]): number {
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);

  return sorted.length % 2 === 0
    ? (sorted[middle - 1]! + sorted[middle]!) / 2
    : sorted[middle]!;
}

function sameShape(shots: Shot[]): Shot[] {
  if (shots.length === 0) return [];

  const reference = median(shots.map((shot) => shot.ratio));

  return shots.filter(
    (shot) => Math.abs(shot.ratio - reference) / reference <= RATIO_TOLERANCE,
  );
}

function interleave(shots: Shot[], limit: number, rotate: boolean): Shot[] {
  const queues = [...Map.groupBy(shots, (shot) => shot.project).values()];

  if (rotate && queues.length > 1) queues.push(queues.shift()!);

  const frames: Shot[] = [];

  while (frames.length < limit && queues.some((queue) => queue.length > 0)) {
    for (const queue of queues) {
      if (frames.length >= limit) break;

      const shot = queue.shift();
      if (shot) frames.push(shot);
    }
  }

  return frames;
}

// Landing-page demos ride along with the project shots, in random slots.
const demos: Shot[] = [demoIdiomas, demoGimnasio].map((image, index) => ({
  src: image.src,
  project: -1 - index,
  ratio: image.width / image.height,
  width: image.width,
  height: image.height,
}));

function sprinkle(frames: Shot[], extras: Shot[]): Shot[] {
  const result = [...frames];

  for (const extra of extras) {
    // Never slot 0: that frame is the eager LCP image.
    const at = 1 + Math.floor(Math.random() * result.length);
    result.splice(at, 0, extra);
  }

  return result;
}

const screenFrames = sprinkle(
  interleave(sameShape(measured.filter((shot) => shot.ratio > 1)), SCREEN_FRAMES, true),
  demos,
);
---
<section
  id="top"
  class="relative isolate overflow-hidden bg-paper px-gutter pt-hero-top pb-[16vh]"
>
  {/* A drawn range, not a photograph. See heroRidges.ts. */}
  <canvas
    id="hero-ridges"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full"></canvas>

  <div class="relative mx-auto grid w-full max-w-content justify-items-center text-center">
    <h1 class="max-w-[18ch] text-headline display-face text-balance">
      {i18n.t("hero.title")}
    </h1>

    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">
      {i18n.t("hero.intro")}
    </p>

    <div class="mt-cta flex flex-wrap items-center justify-center gap-3">
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center gap-2.5 bg-moss px-6 py-3.5 text-paper transition-colors duration-200 hover:bg-ink-soft active:scale-[0.99]"
      >
        <WhatsAppIcon class="h-4.5 w-4.5" />
        <span class="text-lead-sm font-medium">{i18n.t("whatsapp.cta")}</span>
      </a>
      <a
        href="#work"
        class="group inline-flex min-h-12 items-center gap-2.5 border border-ink px-6 py-3.5 transition-colors duration-200 hover:bg-ink hover:text-paper"
      >
        <span class="text-lead-sm font-medium">{i18n.t("hero.ctaSecondary")}</span
        >
        <span
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-1"
        >
          &#8594;
        </span>
      </a>
    </div>

    <div
      id="hero-stage"
      class="mt-flow w-full max-w-[860px] [perspective:1200px] [perspective-origin:50%_0%]"
    >
      <div
        id="hero-shot"
        class="relative w-full origin-top border border-rule-strong bg-substrate p-2 will-change-transform [transform-style:preserve-3d]"
      >
      <div
        role="img"
        aria-label={i18n.t("hero.screenAlt")}
        class="relative aspect-16/10 w-full overflow-hidden bg-paper"
      >
        {
          screenFrames.length > 0 ? (
            screenFrames.map((frame, index) => (
              <img
                src={frame.src}
                alt=""
                aria-hidden="true"
                width={frame.width}
                height={frame.height}
                decoding="async"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                data-hero-frame={index}
                style={`opacity:${index === 0 ? 1 : 0}`}
                class="absolute inset-0 block h-full w-full object-cover object-top"
              />
            ))
          ) : (
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="label text-mute">
                {i18n.t("work.shotPlaceholder")}
              </span>
            </span>
          )
        }

        <span
          aria-hidden="true"
          class="halftone-fine absolute inset-0 opacity-8"></span>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import { initHeroShot } from "@/scripts/heroShot";
  import { initHeroRidges } from "@/scripts/heroRidges";

  initHeroRidges();
  initHeroShot();
</script>
