---
import {
  Building2,
  Leaf,
  Users,
  Rocket,
  Check,
  ShoppingBag,
  TrendingUp,
  LayoutGrid,
  Monitor,
  ShoppingCart,
  BarChart3,
  Globe,
  Zap,
  ArrowRight,
  Wallet,
  Package,
  Clock,
  LineChart,
  UserX,
  CalendarDays,
  MapPin,
  Share2,
  Files,
  MessageCircle,
} from '@lucide/astro';

export type IconName =
  | "store"
  | "leaf"
  | "users"
  | "accessibility"
  | "check"
  | "shopping-bag"
  | "trending-up"
  | "layout"
  | "landing-pages"
  | "ecommerce"
  | "business-tool"
  | "marketing"
  | "globe"
  | "zap"
  | "arrow-right"
  | "wallet"
  | "package"
  | "clock"
  | "line-chart"
  | "user-x"
  | "calendar"
  | "map-pin"
  | "instagram"
  | "pages"
  | "whatsapp";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<IconName, any> = {
  store: Building2,
  leaf: Leaf,
  users: Users,
  accessibility: Rocket,
  check: Check,
  "shopping-bag": ShoppingBag,
  "trending-up": TrendingUp,
  layout: LayoutGrid,
  "landing-pages": Monitor,
  ecommerce: ShoppingCart,
  "business-tool": BarChart3,
  marketing: TrendingUp,
  globe: Globe,
  zap: Zap,
  "arrow-right": ArrowRight,
  wallet: Wallet,
  package: Package,
  clock: Clock,
  "line-chart": LineChart,
  "user-x": UserX,
  calendar: CalendarDays,
  "map-pin": MapPin,
  instagram: Share2,
  pages: Files,
  whatsapp: MessageCircle,
};

const IconComponent = icons[name];
---

{IconComponent && <IconComponent class:list={["block", className]} />}
