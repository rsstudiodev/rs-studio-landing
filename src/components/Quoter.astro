---
import i18n from "i18next";
import QuoterIsland, { type QuoterProps } from "./Quoter";

type Props = Omit<QuoterProps, "labels" | "onSubmit">;

const {
  instanceId,
  sectionTitle,
  questions,
  whatsappNumber,
  whatsappTemplate,
  className,
  secondaryCta,
  collectContact,
  introText,
  surface,
} = Astro.props;

const labels = {
  next: i18n.t("quoter.next"),
  back: i18n.t("quoter.back"),
  step: i18n.t("quoter.step"),
  summaryTitle: i18n.t("quoter.summaryTitle"),
  sendToWhatsApp: i18n.t("quoter.sendToWhatsApp"),
  otherLabel: i18n.t("quoter.otherLabel"),
  unspecified: i18n.t("quoter.unspecified"),
  extraNotesTitle: i18n.t("quoter.extraNotesTitle"),
  extraNotesPlaceholder: i18n.t("quoter.extraNotesPlaceholder"),
  extraNotesLabel: i18n.t("quoter.extraNotesLabel"),
  charactersLeft: i18n.t("quoter.charactersLeft"),
  singleSelectHint: i18n.t("quoter.singleSelectHint"),
  multiSelectHint: i18n.t("quoter.multiSelectHint"),
  contactStepTitle: i18n.t("quoter.contactStepTitle"),
  contactHint: i18n.t("quoter.contactHint"),
  contactNameLabel: i18n.t("quoter.contactNameLabel"),
  contactNamePlaceholder: i18n.t("quoter.contactNamePlaceholder"),
  contactEmailLabel: i18n.t("quoter.contactEmailLabel"),
  contactEmailPlaceholder: i18n.t("quoter.contactEmailPlaceholder"),
  contactPhoneLabel: i18n.t("quoter.contactPhoneLabel"),
  contactPhonePlaceholder: i18n.t("quoter.contactPhonePlaceholder"),
  thankYouMessage: i18n.t("quoter.thankYouMessage"),
};
---

<QuoterIsland
  client:load
  instanceId={instanceId}
  sectionTitle={sectionTitle}
  questions={questions}
  whatsappNumber={whatsappNumber}
  whatsappTemplate={whatsappTemplate}
  className={className}
  labels={labels}
  secondaryCta={secondaryCta}
  collectContact={collectContact}
  introText={introText}
  surface={surface}
/>
