---
interface Props {
  title: string;
  meta?: string;
  tone?: "paper" | "dark";
  id?: string;
  class?: string;
}

const { title, meta, tone = "paper", id, class: className } = Astro.props;

const dark = tone === "dark";
---

<div class:list={[dark ? "border-reverse-rule" : "border-rule", "border-t pt-6", className]}>
  <h2 id={id} class="max-w-[20ch] text-section display-face text-balance">
    {title}
  </h2>
</div>
