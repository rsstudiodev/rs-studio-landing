---
import i18n from "i18next";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { whatsappHref } from "@/lib/whatsapp";

const href = whatsappHref();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={i18n.t("whatsapp.label")}
  class="fixed right-6 bottom-6 z-(--z-float) flex h-14 w-14 items-center justify-center bg-moss text-paper transition-colors duration-200 hover:bg-ink-soft active:scale-[0.98]"
>
  <WhatsAppIcon class="h-6 w-6" />
</a>
