---

interface Props {
  deliverables: string[];
  background?: "paper" | "substrate";
}

const { deliverables, background = "substrate" } = Astro.props;
const bgClass = background === "paper" ? "bg-paper" : "bg-substrate";
---

<section data-reveal class={`relative isolate ${bgClass} px-gutter py-section`}>
  <div class="relative mx-auto w-full max-w-content">
    <ul class="m-0 border-t border-rule pt-6 grid list-none grid-cols-1 gap-x-grid gap-y-2 p-0 sm:grid-cols-2 wide:grid-cols-3">
      {deliverables.map((item) => <li class="text-lead-sm text-ink-soft">{item}</li>)}
    </ul>
  </div>
</section>
