---
interface Props {
  deliverables: string[];
  background?: "paper" | "substrate";
}

const { deliverables, background = "substrate" } = Astro.props;
const bgClass = background === "paper" ? "bg-paper" : "bg-substrate";
---

<section data-reveal class={`${bgClass} px-gutter py-section`}>
  <ul class="mx-auto m-0 grid w-full max-w-content list-none grid-cols-1 gap-x-grid p-0 sm:grid-cols-2 wide:grid-cols-3">
    {
      deliverables.map((item) => (
        <li class="border-t border-rule py-5 text-lead-sm text-pretty text-ink-soft">{item}</li>
      ))
    }
  </ul>
</section>
