---
interface Props {
  title: string;
  items: string[];
  background?: "paper" | "substrate";
}

const { title, items, background = "substrate" } = Astro.props;
const bgClass = background === "paper" ? "bg-paper" : "bg-substrate";
---

<section data-reveal class={`${bgClass} px-gutter py-section`}>
  <div class="mx-auto w-full max-w-content">
    <h2 class="max-w-[24ch] text-section display-face text-balance">{title}</h2>
    <ul class="m-0 mt-heading grid list-none grid-cols-1 gap-x-grid p-0 sm:grid-cols-2 wide:grid-cols-3">
      {
        items.map((item) => (
          <li class="border-t border-rule py-4 text-lead-sm text-ink-soft">{item}</li>
        ))
      }
    </ul>
  </div>
</section>
