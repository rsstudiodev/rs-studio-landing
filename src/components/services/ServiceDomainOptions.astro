---
import i18n from "i18next";
import SectionHead from "@/components/SectionHead.astro";
import HoverCard from "@/components/HoverCard.astro";

interface Props {
  title: string;
  intro: string;
  custom: { heading: string; items: string[]; examples: DomainExample[] };
  subdomain: { heading: string; items: string[]; examples: DomainExample[] };
  background?: "paper" | "substrate";
}

type DomainExample = { label: string; href: string };

const { title, intro, custom, subdomain, background = "paper" } = Astro.props;
const bgClass = background === "substrate" ? "bg-substrate" : "bg-paper";
---

<section data-reveal class={`relative isolate ${bgClass} px-gutter py-section`}>
  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={i18n.t("servicePage.domainOptionsLabel")} />
    <h3 class="mt-heading max-w-[28ch] text-step display-face text-balance">
      {title}
    </h3>
    <p class="mt-4 max-w-prose text-lead text-pretty text-graphite">{intro}</p>
    <div
      class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow md:grid-cols-2"
    >
      <HoverCard icon="globe" heading={custom.heading} items={custom.items}>
        {i18n.t("servicePage.example")}
        {
          custom.examples.map((example) => (
            <a
              class="block font-mono text-lead-sm text-mute transition-colors hover:text-moss hover:underline"
              href={example.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {example.label}
            </a>
          ))
        }
      </HoverCard>
      <HoverCard icon="zap" heading={subdomain.heading} items={subdomain.items}>
        <div class="space-y-1">
          {i18n.t("servicePage.example")}
          {
            subdomain.examples.map((example) => (
              <a
                class="block font-mono text-lead-sm text-mute transition-colors hover:text-moss hover:underline"
                href={example.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {example.label}
              </a>
            ))
          }
        </div>
      </HoverCard>
    </div>
  </div>
</section>
