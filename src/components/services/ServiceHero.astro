---
import i18n from "i18next";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import RidgeBand from "@/components/RidgeBand.astro";
import CalWidget from "@/components/CalWidget";
import { whatsappHref } from "@/lib/whatsapp";

interface Props {
  title: string;
  intro: string;
  whatsappMessage: string;
}

const { title, intro, whatsappMessage } = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-paper px-gutter pt-hero-top pb-hero-bottom"
>
  <RidgeBand class="absolute inset-x-0 bottom-0 -z-10 h-[40%] w-full" />

  <div class="relative mx-auto w-full max-w-content">
    <h1 class="max-w-[20ch] text-display display-face text-balance">{title}</h1>
    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">{intro}</p>
    <div class="mt-cta flex flex-wrap items-center gap-3">
      <a
        href={whatsappHref(whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center gap-2.5 bg-moss px-6 py-3.5 text-paper transition-colors duration-200 hover:bg-pine active:scale-[0.99]"
      >
        <WhatsAppIcon class="h-4.5 w-4.5" />
        <span class="text-lead-sm font-medium">{i18n.t("cta.requestProposal")}</span>
      </a>
      <CalWidget
        client:idle
        eventSlug="rs-studio/descubrimiento"
        triggerLabel={i18n.t("quoter.scheduleCall")}
        mode="popup"
        theme={{ brandColor: "#000000", borderRadius: 0 }}
        className="inline-flex min-h-12 items-center border border-rule px-6 py-3.5 text-lead-sm font-medium text-graphite transition-colors duration-200 hover:border-moss hover:text-moss"
      />
    </div>
  </div>
</section>
