---
import i18n from "i18next";
import ServiceHero from "./ServiceHero.astro";
import ServiceProblem from "./ServiceProblem.astro";
import ServiceBenefits from "./ServiceBenefits.astro";
import ServiceDeliverables from "./ServiceDeliverables.astro";
import ServicePainPoints from "./ServicePainPoints.astro";
import ServiceDomainOptions from "./ServiceDomainOptions.astro";
import ServiceTrust from "./ServiceTrust.astro";
import ServiceDesignedFor from "./ServiceDesignedFor.astro";
import ServiceProcess from "./ServiceProcess.astro";
import ServiceFaq from "./ServiceFaq.astro";
import ServiceSchema from "./ServiceSchema.astro";
import ServiceQuoter from "./ServiceQuoter.astro";
import { servicePath, type ServiceKey } from "@/i18n/routing";
import type { QuoterQuestion } from "@/lib/quoter";

interface Props {
  serviceKey: ServiceKey;
}

type Service = {
  title: string;
  intro: string;
  problem: string;
  whyItMatters: string;
  benefits: string[];
  deliverables: string[];
  painPoints?: {
    title: string;
    intro?: string;
    categories: { category: string; icon: string; title: string; description: string; outcome: string }[];
  };
  domainOptions?: {
    title: string;
    intro: string;
    custom: { heading: string; items: string[]; examples: DomainExample[] };
    subdomain: { heading: string; items: string[]; examples: DomainExample[] };
  };
  quoter?: {
    instanceId: string;
    sectionTitle: string;
    heading: string;
    subheading: string;
    whatsappTemplate: string;
    questions: QuoterQuestion[];
  };
  trust?: { title: string; body: string; items: string[]; quote: string };
  designedFor?: { title: string; items: string[] };
  process: { title: string; body: string }[];
  faq: { question: string; answer: string }[];
  meta: { title: string; description: string };
  whatsappMessage: string;
};

type DomainExample = { label: string; href: string };

const { serviceKey } = Astro.props;
const service = i18n.t(serviceKey, { ns: "services", returnObjects: true }) as unknown as Service;
const path = servicePath(serviceKey);
const url = Astro.site ? new URL(path, Astro.site).href : path;

// landingPages hides Deliverables and DesignedFor; businessManagementTool hides
// Deliverables. Other services keep them.
const isLandingPages = serviceKey === "landingPages";
const showDeliverables = !isLandingPages && serviceKey !== "businessManagementTool";
const showDesignedFor = !isLandingPages && !!service.designedFor;

// Benefits (paper) is always the last fixed-background section before this
// point. A running toggle advances only when a section actually renders, so
// every section stays correctly alternated regardless of which optional
// sections are present.
const nextBg = (bg: "paper" | "substrate") => (bg === "paper" ? "substrate" : "paper");
let bg: "paper" | "substrate" = "substrate";
const quoterBg = bg;
if (service.quoter) bg = nextBg(bg);
const deliverablesBg = bg;
if (showDeliverables) bg = nextBg(bg);
const domainOptionsBg = bg;
if (service.domainOptions) bg = nextBg(bg);
const trustBg = bg;
if (service.trust) bg = nextBg(bg);
const designedForBg = bg;
if (showDesignedFor) bg = nextBg(bg);
const processBg = bg;
bg = nextBg(bg);
const faqBg = bg;
---

<ServiceHero title={service.title} intro={service.intro} whatsappMessage={service.whatsappMessage} />
<ServiceProblem problem={service.problem} whyItMatters={service.whyItMatters} />
{service.painPoints ? <ServicePainPoints {...service.painPoints} /> : <ServiceBenefits benefits={service.benefits} />}
{service.quoter && <ServiceQuoter {...service.quoter} background={quoterBg} />}
{showDeliverables && <ServiceDeliverables deliverables={service.deliverables} background={deliverablesBg} />}
{service.domainOptions && <ServiceDomainOptions {...service.domainOptions} background={domainOptionsBg} />}
{service.trust && <ServiceTrust {...service.trust} background={trustBg} />}
{showDesignedFor && <ServiceDesignedFor {...service.designedFor} background={designedForBg} />}
<ServiceProcess process={service.process} background={processBg} />
<ServiceFaq faq={service.faq} background={faqBg} />
<ServiceSchema name={service.title} description={service.meta.description} url={url} />
