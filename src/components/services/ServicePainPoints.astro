---
import SectionHead from "@/components/SectionHead.astro";
import Icon, { type IconName } from "@/components/Icon.astro";

interface PainPoint {
  category: string;
  icon: string;
  title: string;
  description: string;
  outcome: string;
}

interface Props {
  title: string;
  intro?: string;
  categories: PainPoint[];
}

const { title, intro, categories } = Astro.props;
---

<section data-reveal class="relative isolate bg-paper px-gutter py-section">
  <div class="relative mx-auto w-full max-w-content">
    <SectionHead title={title} />
    {intro && <p class="mt-6 max-w-prose text-lead text-pretty text-graphite">{intro}</p>}

    <div class="mt-heading grid grid-cols-1 gap-x-grid gap-y-flow sm:grid-cols-2 wide:grid-cols-3">
      {
        categories.map((point) => (
          <div class="border-t border-rule pt-8">
            <Icon name={point.icon as IconName} class="h-8 w-8 shrink-0 text-moss" />
            <h3 class="mt-4 text-lead font-medium text-ink">{point.title}</h3>
            <p class="mt-2 text-lead-sm text-pretty text-ink-soft">{point.description}</p>
            <p class="mt-3 flex items-start gap-2 text-lead-sm text-pretty text-moss">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
              <span>{point.outcome}</span>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
