---

interface Props {
  problem: string;
  whyItMatters: string;
}

const { problem, whyItMatters } = Astro.props;
---

<section data-reveal class="relative isolate bg-substrate px-gutter py-section">
  <div class="relative mx-auto w-full max-w-content">
    <div class="grid grid-cols-1 gap-split wide:grid-cols-[0.75fr_1.25fr]">
      <div class="border-t border-rule"></div>
      <div class="max-w-prose text-lead text-pretty text-graphite">
        <p>{problem}</p>
        <p class="mt-heading">{whyItMatters}</p>
      </div>
    </div>
  </div>
</section>
