---
interface Props {
  problem: string;
  whyItMatters: string;
}

const { problem, whyItMatters } = Astro.props;
---

<section data-reveal class="bg-substrate px-gutter py-section">
  <div class="mx-auto w-full max-w-content">
    <p class="max-w-[36ch] text-section display-face text-balance text-pine">{problem}</p>
    <p class="mt-heading max-w-prose border-t border-rule pt-6 text-lead text-pretty text-graphite">
      {whyItMatters}
    </p>
  </div>
</section>
