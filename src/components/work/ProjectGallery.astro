---
import i18n from "i18next";
import Carousel from "@/components/carousel.astro";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
  images: string[];
}

const { project, images } = Astro.props;

const screenshots = images.map((src, index) => ({
  src,
  alt: i18n.t("projectPage.screenshotAlt", { title: project.title, index: index + 1 }),
}));

const labels = {
  previous: i18n.t("carousel.previous"),
  next: i18n.t("carousel.next"),
  open: i18n.t("carousel.open"),
  close: i18n.t("carousel.close"),
  goTo: (index: number) => i18n.t("carousel.goTo", { index }),
};
---

{
  screenshots.length > 0 && (
    <section data-reveal class="bg-substrate px-gutter py-section">
      <div class="mx-auto w-full max-w-content">
        <div class="border-t border-rule" />

        <Carousel
          images={screenshots}
          id="project-gallery"
          label={i18n.t("projectPage.galleryRegion")}
          labels={labels}
          class="mt-heading"
          heightClass="h-96 sm:h-[30rem] lg:h-[38rem]"
          stageClass="bg-paper"
          controlClass="bg-paper/90 p-2.5 text-graphite transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-current"
          thumbnails
          screenClass="halftone-fine opacity-8"
        />
      </div>
    </section>
  )
}
