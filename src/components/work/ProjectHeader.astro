---
import RidgeBand from "@/components/RidgeBand.astro";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-paper px-gutter pt-hero-top pb-hero-bottom"
>
  <RidgeBand class="absolute inset-x-0 bottom-0 -z-10 h-[40%] w-full" />

  <div class="relative mx-auto w-full max-w-content">
    <h1 class="max-w-[20ch] text-display display-face text-balance">{project.title}</h1>
    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">
      {project.brief_description}
    </p>
  </div>
</section>
