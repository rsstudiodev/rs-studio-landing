---
import i18n from "i18next";
import { sectionHref } from "@/i18n/routing";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const backHref = sectionHref(Astro.url.pathname, "#work");
const isExternal = Boolean(project.href?.startsWith("http"));

const meta = [
  {
    label: i18n.t("projectPage.categoryLabel"),
    value: project.category,
    href: project["category-link"],
  },
  { label: i18n.t("projectPage.yearLabel"), value: project.year },
];
---

<section class="relative isolate bg-paper px-gutter pt-10 pb-heading">
  <div class="relative mx-auto w-full max-w-content">
    <a
      href={backHref}
      class="group inline-flex items-center gap-2 text-lead-sm text-graphite transition-colors duration-200 hover:text-ink"
    >
      <span
        aria-hidden="true"
        class="text-moss transition-transform duration-200 group-hover:-translate-x-1"
      >
        &#8592;
      </span>
      {i18n.t("projectPage.back")}
    </a>
    <h1 class="mt-hero-top max-w-[18ch] text-display display-face text-balance">{project.title}</h1>
    <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">
      {project.brief_description}
    </p>
    <dl class="mt-cta grid grid-cols-2 gap-x-grid border-t border-rule pt-6 sm:max-w-md">
      {
        meta.map((item) => (
          <div>
            <dt class="label text-mute">{item.label}</dt>
            <dd class="tnum mt-2 text-subhead display-face">
              {item.href ? (
                <a
                  href={item.href}
                  class="text-moss underline decoration-rule underline-offset-4 transition-colors duration-200 hover:text-pine hover:decoration-current"
                >
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      project.href && (
        <a
          href={project.href}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class="group mt-cta inline-flex min-h-12 items-center gap-2.5 bg-moss px-6 py-3.5 text-paper transition-colors duration-200 hover:bg-pine active:scale-[0.99]"
        >
          <span class="text-lead-sm font-medium">
            {project.cta ?? i18n.t("projectPage.visitSite")}
          </span>
          <span
            aria-hidden="true"
            class="opacity-70 transition-transform duration-200 group-hover:translate-x-1"
          >
            &#8594;
          </span>
        </a>
      )
    }
  </div>
</section>
