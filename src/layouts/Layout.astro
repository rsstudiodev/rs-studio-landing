---
import "@/styles/global.css";
import i18n from "i18next";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import OrganizationSchema from "@/components/OrganizationSchema.astro";
import { getLocaleOptions } from "@/i18n/locales";
import { getLocalizedPathname } from "astro-react-i18next/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  canonicalURL?: string;
}

const {
  title = i18n.t("meta.title"),
  description = i18n.t("meta.description"),
  ogImage: ogImageProp,
  ogImageAlt,
  ogType = "website",
  canonicalURL,
} = Astro.props;

const canonical = Astro.site
  ? canonicalURL
    ? new URL(canonicalURL)
    : new URL(Astro.url.pathname, Astro.site)
  : undefined;
const usingDefaultOgImage = !ogImageProp;
const ogImage = Astro.site
  ? new URL(ogImageProp || "/monogram.png", Astro.site)
  : undefined;

const alternates = Astro.site
  ? getLocaleOptions().map((locale) => ({
      code: locale.code,
      href: new URL(getLocalizedPathname(Astro.url.pathname, locale.code), Astro.site).href,
    }))
  : [];
---

<!doctype html>
<html lang={i18n.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1512" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Resolves the stored theme before first paint, so a dark reader never
         gets a white flash. Light is the default when nothing is stored. -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme");
        const dark =
          theme === "dark" ||
          (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>

    <!-- A reload must start at the top: the hero scroll effect only plays from
         there. A hash link keeps the browser's own target. -->
    <script is:inline>
      if (!location.hash && "scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
      ))
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="RS Studio" />
    <meta property="og:locale" content={i18n.language.replace("-", "_")} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {ogImage && <meta property="og:image" content={ogImage.href} />}
    {ogImage && usingDefaultOgImage && <meta property="og:image:width" content="320" />}
    {ogImage && usingDefaultOgImage && <meta property="og:image:height" content="320" />}
    {ogImage && (
      <meta property="og:image:alt" content={ogImageAlt ?? i18n.t("hero.monogramAlt")} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage.href} />}

    <OrganizationSchema />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{i18n.t("nav.skipToContent")}</a>
    <slot />
    <WhatsAppButton />

    <script>
      import { initSectionReveal } from "@/scripts/sectionReveal";

      initSectionReveal();
    </script>
  </body>
</html>
