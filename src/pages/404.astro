---
import i18n from "i18next";
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Contact from "@/components/Contact.astro";
import { homePath, sectionHref } from "@/i18n/routing";

const home = homePath();
const workHref = sectionHref("/404", "#work");
---

<Layout title={`${i18n.t("notFound.title")} — RS Studio`} description={i18n.t("notFound.intro")}>
  <SiteHeader />

  <main id="main" class="bg-paper px-gutter pt-hero-top pb-hero-bottom">
    <div class="mx-auto w-full max-w-content">
      <h1 class="max-w-[16ch] text-display display-face text-balance">
        {i18n.t("notFound.title")}
      </h1>

      <p class="mt-lead max-w-prose text-lead text-pretty text-graphite">
        {i18n.t("notFound.intro")}
      </p>

      <div class="mt-cta flex flex-wrap items-center gap-3">
        <a
          href={home}
          class="inline-flex min-h-12 items-center bg-moss px-6 py-3.5 text-paper transition-colors duration-200 hover:bg-pine active:scale-[0.99]"
        >
          <span class="text-lead-sm font-medium">{i18n.t("notFound.home")}</span>
        </a>

        <a
          href={workHref}
          class="group inline-flex min-h-12 items-center gap-2.5 border border-rule-strong px-6 py-3.5 transition-colors duration-200 hover:border-moss hover:text-moss"
        >
          <span class="text-lead-sm font-medium">{i18n.t("notFound.work")}</span>
          <span
            aria-hidden="true"
            class="text-mute transition-transform duration-200 group-hover:translate-x-1"
          >
            &#8594;
          </span>
        </a>
      </div>
    </div>
  </main>

  <Contact />
</Layout>
