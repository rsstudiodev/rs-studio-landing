---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Contact from "@/components/Contact.astro";
import BackToHome from "@/components/BackToHome.astro";
import ProjectHeader from "@/components/work/ProjectHeader.astro";
import ProjectOverview from "@/components/work/ProjectOverview.astro";
import ProjectGallery from "@/components/work/ProjectGallery.astro";
import { render } from "astro:content";
import { buildStaticPaths } from "astro-react-i18next/utils";
import { projectSlugs, caseStudySlugs, projectScreenshots, findProject } from "@/content/projects";
import i18n from "i18next";

export function getStaticPaths() {
  return buildStaticPaths().flatMap(({ params }) =>
    caseStudySlugs.map((slug) => ({ params: { ...params, slug } })),
  );
}

const { slug } = Astro.params;
const lang = i18n.language as "en-US" | "es-MX";
const entry = findProject(lang, slug ?? "");

if (!entry) {
  throw new Error(`No project matches the slug "${slug}". Are the locale files out of sync?`);
}

const project = entry.data;
const { Content } = await render(entry);

const index = projectSlugs.indexOf(slug ?? "");
const ogImage = projectScreenshots[index]?.[0];
---

<Layout
  title={i18n.t("projectPage.titleTemplate", { name: project.title })}
  description={project.brief_description}
  ogImage={ogImage}
>
  <SiteHeader />
  <main id="main">
    <ProjectHeader project={project} />
    <ProjectOverview project={project}>
      <Content />
    </ProjectOverview>
    <ProjectGallery project={project} images={projectScreenshots[index]!} />
  </main>
  <BackToHome />
  <Contact />
</Layout>
